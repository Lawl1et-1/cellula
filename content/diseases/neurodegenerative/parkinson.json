  "cellContext": {
    "cellType": "neuron",
    "note": {
      "text": {
        "fr": "Ce sont surtout les neurones dopaminergiques de la substance noire qui dégénèrent. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "It is mainly the dopaminergic neurons of the substantia nigra that degenerate. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-parkinson"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie neurodégénérative marquée par la perte des neurones dopaminergiques de la substance noire et par des inclusions d'alpha-synucléine, les corps de Lewy.",
      "en": "A neurodegenerative disease marked by the loss of dopaminergic neurons in the substantia nigra and by inclusions of alpha-synuclein, the Lewy bodies."
    },
    "sources": [
      {
        "id": "sp-parkinson"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "La plupart des cas n'ont pas de cause unique identifiée ; des facteurs génétiques et environnementaux interviennent, et de rares formes sont monogéniques.",
        "en": "Most cases have no single identified cause; genetic and environmental factors play a part, and rare forms are monogenic."
      },
      "sources": [
        {
          "id": "sp-parkinson"
        }
      ]
    }
  ],
