          "id": "sp-parkinson"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie neurodégénérative marquée par la perte des neurones dopaminergiques de la substance noire et par des inclusions d'alpha-synucléine, les corps de Lewy."
    },
    "sources": [
      {
        "id": "sp-parkinson"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "La plupart des cas n'ont pas de cause unique identifiée ; des facteurs génétiques et environnementaux interviennent, et de rares formes sont monogéniques."
      },
      "sources": [
        {
          "id": "sp-parkinson"
        }
      ]
    }
  ],
