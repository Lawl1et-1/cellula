{
  "id": "sla",
  "slug": "sclerose-laterale-amyotrophique",
  "name": {
    "fr": "Sclérose latérale amyotrophique (SLA)"
  },
  "aliases": [
    "Maladie de Charcot"
  ],
  "categories": [
    "neurodegenerative"
  ],
  "cellContext": {
    "cellType": "neuron",
    "note": {
      "text": {
        "fr": "Les neurones moteurs du cerveau et de la moelle épinière dégénèrent. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "gr-als"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie neurodégénérative des neurones moteurs. Dans la plupart des cas, la protéine TDP-43 quitte le noyau et forme des agrégats dans le cytoplasme."
    },
    "sources": [
      {
        "id": "gr-als"
      },
      {
        "id": "pm-als-2016"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "La plupart des cas sont sporadiques ; une minorité est familiale, liée notamment aux gènes C9orf72, SOD1, TARDBP ou FUS."
      },
      "sources": [
        {
          "id": "gr-als"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "nucleus",
    "cytoplasm",
    "cytoskeleton"
  ],
