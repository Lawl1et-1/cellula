  "name": {
    "fr": "Sclérose latérale amyotrophique (SLA)",
    "en": "Amyotrophic lateral sclerosis (ALS)"
  },
  "aliases": [
    "Maladie de Charcot"
  ],
  "categories": [
    "neurodegenerative"
  ],
  "cellContext": {
    "cellType": "neuron",
    "note": {
      "text": {
        "fr": "Les neurones moteurs du cerveau et de la moelle épinière dégénèrent. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "Motor neurons in the brain and spinal cord degenerate. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "gr-als"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie neurodégénérative des neurones moteurs. Dans la plupart des cas, la protéine TDP-43 quitte le noyau et forme des agrégats dans le cytoplasme.",
      "en": "A neurodegenerative disease of motor neurons. In most cases, the TDP-43 protein leaves the nucleus and forms aggregates in the cytoplasm."
    },
    "sources": [
      {
        "id": "gr-als"
      },
      {
        "id": "pm-als-2016"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "La plupart des cas sont sporadiques ; une minorité est familiale, liée notamment aux gènes C9orf72, SOD1, TARDBP ou FUS.",
        "en": "Most cases are sporadic; a minority are familial, linked notably to the C9orf72, SOD1, TARDBP or FUS genes."
      },
      "sources": [
        {
          "id": "gr-als"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "nucleus",
    "cytoplasm",
    "cytoskeleton"
  ],
  "affectedPathways": [
    "agrégation protéique",
    "transport axonal"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "TDP-43 hors du noyau",
        "en": "TDP-43 outside the nucleus"
      },
      "explanation": {
        "text": {
          "fr": "TDP-43, une protéine qui lie l'ARN, se retrouve dans le cytoplasme où elle s'agrège.",
          "en": "TDP-43, an RNA-binding protein, ends up in the cytoplasm, where it aggregates."
        },
        "sources": [
