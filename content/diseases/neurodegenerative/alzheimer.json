{
  "id": "alzheimer",
  "slug": "maladie-d-alzheimer",
  "name": {
    "fr": "Maladie d'Alzheimer"
  },
  "aliases": [],
  "categories": [
    "neurodegenerative"
  ],
  "cellContext": {
    "cellType": "neuron",
    "note": {
      "text": {
        "fr": "La maladie touche les neurones du cerveau, en particulier dans les régions de la mémoire. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "sp-alzheimer"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie neurodégénérative marquée par des plaques amyloïdes entre les neurones et des enchevêtrements de protéine tau dans les neurones, qui finissent par mourir."
    },
    "sources": [
      {
        "id": "sp-alzheimer"
      },
      {
        "id": "mboc4-aggregates"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Dans la grande majorité des cas, la maladie n'est pas due à un seul gène ; de rares formes familiales sont liées à des variants des gènes APP, PSEN1 ou PSEN2."
      },
      "sources": [
        {
          "id": "gr-alzheimer"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "cytoskeleton",
    "cytoplasm"
  ],
  "affectedPathways": [
    "agrégation protéique",
    "transport le long des microtubules"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Plaques amyloïdes"
      },
      "explanation": {
        "text": {
          "fr": "Des fragments du peptide bêta-amyloïde s'agrègent hors des neurones en plaques."
        },
        "sources": [
          {
            "id": "sp-alzheimer"
          },
          {
            "id": "mboc4-aggregates"
          }
        ],
        "simplification": {
          "fr": "Les plaques, situées hors de la cellule, ne sont pas représentées."
        }
      }
    },
    {
      "title": {
        "fr": "Enchevêtrements de tau"
      },
      "explanation": {
        "text": {
          "fr": "La protéine tau, normalement associée aux microtubules, forme des enchevêtrements neurofibrillaires dans les neurones."
        },
        "sources": [
          {
            "id": "sp-alzheimer"
          }
        ]
      },
      "organelle": "cytoskeleton"
    },
    {
      "title": {
        "fr": "Perte neuronale",
        "en": "Neuronal loss"
      },
      "explanation": {
        "text": {
          "fr": "Les neurones dysfonctionnent puis meurent, ce qui entraîne l'atrophie du cerveau."
        },
        "sources": [
          {
            "id": "sp-alzheimer"
          }
        ]
      }
    }
  ],
  "stages": [
