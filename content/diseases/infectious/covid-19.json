{
  "id": "covid-19",
  "slug": "covid-19",
  "name": {
    "fr": "COVID-19 (SARS-CoV-2)",
    "en": "COVID-19 (SARS-CoV-2)"
  },
  "aliases": [
    "SARS-CoV-2"
  ],
  "categories": [
    "infectious"
  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Le virus infecte notamment les cellules épithéliales des voies respiratoires. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "The virus infects, among others, the epithelial cells of the airways. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-covid"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par le coronavirus SARS-CoV-2, qui entre dans la cellule, détourne ses membranes pour fabriquer des usines de réplication et produit de nouvelles particules virales.",
      "en": "Infection with the SARS-CoV-2 coronavirus, which enters the cell, hijacks its membranes to build replication factories and produces new virus particles."
    },
    "sources": [
      {
        "id": "sp-covid"
      },
      {
        "id": "pm-dmv-2020"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Le virus SARS-CoV-2, transmis surtout par voie respiratoire.",
        "en": "The SARS-CoV-2 virus, spread mainly through the airways."
      },
      "sources": [
        {
          "id": "sp-covid"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "rough-er",
    "golgi"
  ],
  "affectedPathways": [
    "entrée virale",
    "réplication virale",
    "voie de sécrétion"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Entrée",
        "en": "Entry"
      },
      "explanation": {
        "text": {
          "fr": "La protéine Spike du virus se lie au récepteur ACE2 de la cellule, puis l'enveloppe virale fusionne avec une membrane cellulaire.",
          "en": "The virus's Spike protein binds to the cell's ACE2 receptor, then the viral envelope fuses with a cell membrane."
        },
        "sources": [
          {
            "id": "sp-covid"
          },
          {
            "id": "mboc4-virus-entry"
          }
        ]
      },
      "organelle": "plasma-membrane"
    },
    {
      "title": {
        "fr": "Usines de réplication",
        "en": "Replication factories"
      },
      "explanation": {
        "text": {
          "fr": "Le génome viral est répliqué dans des vésicules à double membrane formées à partir du réticulum endoplasmique.",
          "en": "The viral genome is replicated in double-membrane vesicles formed from the endoplasmic reticulum."
        },
        "sources": [
          {
            "id": "pm-dmv-2020"
          }
        ]
      },
      "organelle": "rough-er"
    },
    {
      "title": {
        "fr": "Assemblage et sortie",
        "en": "Assembly and exit"
      },
      "explanation": {
        "text": {
          "fr": "Les nouvelles particules sont assemblées grâce aux membranes de la cellule puis libérées.",
          "en": "New particles are assembled using the cell's membranes and then released."
        },
        "sources": [
          {
            "id": "mboc4-viruses-host"
          }
        ]
      },
      "organelle": "golgi"
    }
  ],
  "stages": [
