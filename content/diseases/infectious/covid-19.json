  ],
  "categories": [
    "infectious"
  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Le virus infecte notamment les cellules épithéliales des voies respiratoires. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "sp-covid"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par le coronavirus SARS-CoV-2, qui entre dans la cellule, détourne ses membranes pour fabriquer des usines de réplication et produit de nouvelles particules virales."
    },
    "sources": [
      {
        "id": "sp-covid"
      },
      {
        "id": "pm-dmv-2020"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Le virus SARS-CoV-2, transmis surtout par voie respiratoire."
      },
      "sources": [
        {
          "id": "sp-covid"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "rough-er",
    "golgi"
  ],
  "affectedPathways": [
    "entrée virale",
    "réplication virale",
    "voie de sécrétion"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Entrée"
      },
      "explanation": {
        "text": {
          "fr": "La protéine Spike du virus se lie au récepteur ACE2 de la cellule, puis l'enveloppe virale fusionne avec une membrane cellulaire."
        },
        "sources": [
          {
            "id": "sp-covid"
          },
          {
            "id": "mboc4-virus-entry"
          }
        ]
      },
      "organelle": "plasma-membrane"
    },
    {
      "title": {
        "fr": "Usines de réplication"
      },
      "explanation": {
        "text": {
          "fr": "Le génome viral est répliqué dans des vésicules à double membrane formées à partir du réticulum endoplasmique."
        },
        "sources": [
          {
            "id": "pm-dmv-2020"
          }
        ]
      },
      "organelle": "rough-er"
    },
    {
      "title": {
        "fr": "Assemblage et sortie"
      },
      "explanation": {
        "text": {
          "fr": "Les nouvelles particules sont assemblées grâce aux membranes de la cellule puis libérées."
        },
        "sources": [
          {
            "id": "mboc4-viruses-host"
          }
        ]
      },
      "organelle": "golgi"
    }
  ],
