      "description": {
        "text": {
          "fr": "Le SARS-CoV-2 s'approche de la cellule : sa protéine Spike se fixe au récepteur ACE2, une protéine de la membrane plasmique.",
          "en": "SARS-CoV-2 approaches the cell: its Spike protein binds to ACE2, a receptor protein in the plasma membrane."
        },
        "sources": [
          {
            "id": "sp-covid"
          }
        ]
      },
