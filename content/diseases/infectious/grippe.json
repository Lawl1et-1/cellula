  "mechanism": [
    {
      "title": {
        "fr": "Entrée par endocytose",
        "en": "Entry by endocytosis"
      },
      "explanation": {
        "text": {
          "fr": "Le virus est internalisé dans un endosome ; l'acidité de l'endosome déclenche la fusion de l'enveloppe virale avec sa membrane.",
          "en": "The virus is taken into an endosome; the acidity of the endosome triggers fusion of the viral envelope with the endosome membrane."
        },
        "sources": [
          {
            "id": "mboc4-virus-entry"
          }
        ]
      },
      "organelle": "vesicle"
    },
    {
      "title": {
        "fr": "Réplication nucléaire",
        "en": "Replication in the nucleus"
      },
      "explanation": {
        "text": {
          "fr": "Le génome viral est transporté dans le noyau, où il est copié.",
          "en": "The viral genome is carried into the nucleus, where it is copied."
        },
        "sources": [
          {
            "id": "mboc4-viruses-host"
          }
        ],
        "simplification": {
          "fr": "Les nombreux segments du génome viral sont représentés comme un seul flux.",
          "en": "The many segments of the viral genome are shown as a single stream."
        }
      },
      "organelle": "nucleus"
    },
    {
      "title": {
        "fr": "Bourgeonnement",
        "en": "Budding"
      },
      "explanation": {
        "text": {
          "fr": "Les nouvelles particules bourgeonnent à la membrane plasmique et sont libérées.",
          "en": "New particles bud from the plasma membrane and are released."
        },
        "sources": [
          {
            "id": "mboc4-pathogen-entry-exit"
          },
          {
            "id": "sp-influenza"
          }
