  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Le virus infecte les cellules épithéliales des voies respiratoires. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "The virus infects the epithelial cells of the airways. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-influenza"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par le virus de la grippe, qui entre par endocytose, fait copier son génome dans le noyau puis bourgeonne à la membrane de la cellule.",
      "en": "Infection with the flu virus, which enters by endocytosis, has its genome copied in the nucleus and then buds from the cell membrane."
    },
    "sources": [
      {
        "id": "sp-influenza"
      },
      {
        "id": "mboc4-virus-entry"
      },
      {
        "id": "mboc4-viruses-host"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Les virus influenza, transmis par voie respiratoire.",
        "en": "Influenza viruses, spread through the airways."
      },
      "sources": [
        {
          "id": "sp-influenza"
        }
      ]
    }
  ],
