{
  "id": "grippe",
  "slug": "grippe",
  "name": {
    "fr": "Grippe (influenza A)",
    "en": "Flu (influenza A)"
  },
  "aliases": [],
  "categories": [
    "infectious"
  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Le virus infecte les cellules épithéliales des voies respiratoires. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "The virus infects the epithelial cells of the airways. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-influenza"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par le virus de la grippe, qui entre par endocytose, fait copier son génome dans le noyau puis bourgeonne à la membrane de la cellule.",
      "en": "Infection with the flu virus, which enters by endocytosis, has its genome copied in the nucleus and then buds from the cell membrane."
    },
    "sources": [
      {
        "id": "sp-influenza"
      },
      {
        "id": "mboc4-virus-entry"
      },
      {
        "id": "mboc4-viruses-host"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Les virus influenza, transmis par voie respiratoire.",
        "en": "Influenza viruses, spread through the airways."
      },
      "sources": [
        {
          "id": "sp-influenza"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "vesicle",
    "nucleus"
  ],
  "affectedPathways": [
    "entrée virale",
    "réplication dans le noyau",
    "bourgeonnement"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Entrée par endocytose",
        "en": "Entry by endocytosis"
      },
      "explanation": {
        "text": {
          "fr": "Le virus est internalisé dans un endosome ; l'acidité de l'endosome déclenche la fusion de l'enveloppe virale avec sa membrane.",
          "en": "The virus is taken into an endosome; the acidity of the endosome triggers fusion of the viral envelope with the endosome membrane."
        },
        "sources": [
          {
            "id": "mboc4-virus-entry"
          }
        ]
      },
      "organelle": "vesicle"
    },
    {
      "title": {
        "fr": "Réplication nucléaire",
        "en": "Replication in the nucleus"
      },
      "explanation": {
        "text": {
          "fr": "Le génome viral est transporté dans le noyau, où il est copié.",
          "en": "The viral genome is carried into the nucleus, where it is copied."
        },
        "sources": [
          {
            "id": "mboc4-viruses-host"
          }
        ],
        "simplification": {
          "fr": "Les nombreux segments du génome viral sont représentés comme un seul flux.",
          "en": "The many segments of the viral genome are shown as a single stream."
        }
      },
      "organelle": "nucleus"
    },
    {
      "title": {
        "fr": "Bourgeonnement",
        "en": "Budding"
      },
      "explanation": {
        "text": {
          "fr": "Les nouvelles particules bourgeonnent à la membrane plasmique et sont libérées.",
          "en": "New particles bud from the plasma membrane and are released."
        },
        "sources": [
          {
            "id": "mboc4-pathogen-entry-exit"
          },
          {
            "id": "sp-influenza"
          }
        ]
      },
      "organelle": "plasma-membrane"
    }
  ],
