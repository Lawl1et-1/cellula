  "name": {
    "fr": "Listériose"
  },
  "aliases": [],
  "categories": [
    "infectious"
  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Listeria peut infecter de nombreux types de cellules, dont les cellules épithéliales de l'intestin. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "sp-listeria"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par la bactérie Listeria monocytogenes, qui vit dans le cytoplasme des cellules et détourne leur actine pour s'y déplacer et passer aux cellules voisines."
    },
    "sources": [
      {
        "id": "sp-listeria"
      },
      {
        "id": "mboc4-pathogen-cytoskeleton"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "La bactérie Listeria monocytogenes, transmise le plus souvent par des aliments contaminés."
      },
      "sources": [
        {
          "id": "sp-listeria"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "cytoplasm",
    "cytoskeleton",
    "vesicle"
  ],
  "affectedPathways": [
    "échappement du phagosome",
    "polymérisation de l'actine"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Entrée et sortie de la vacuole"
      },
      "explanation": {
        "text": {
          "fr": "Après son entrée, la bactérie s'échappe de la vacuole qui l'entoure et se retrouve libre dans le cytoplasme."
        },
        "sources": [
          {
            "id": "mboc4-pathogen-entry-exit"
          },
          {
            "id": "sp-listeria"
          }
        ]
      },
      "organelle": "vesicle"
    },
    {
      "title": {
        "fr": "Comètes d'actine"
      },
      "explanation": {
        "text": {
          "fr": "À sa surface, la protéine ActA fait polymériser l'actine de la cellule : une « comète » d'actine pousse la bactérie."
        },
        "sources": [
          {
            "id": "mboc4-pathogen-cytoskeleton"
          },
          {
            "id": "sp-listeria"
          }
        ]
      },
      "organelle": "cytoskeleton"
    },
    {
      "title": {
        "fr": "Propagation"
      },
      "explanation": {
        "text": {
          "fr": "Poussée par l'actine, la bactérie forme des protrusions qui pénètrent dans les cellules voisines."
        },
        "sources": [
          {
            "id": "mboc4-pathogen-cytoskeleton"
          }
        ]
      }
    }
  ],
  "stages": [
