{
  "id": "vih",
  "slug": "vih-sida",
  "name": {
    "fr": "Infection par le VIH",
    "en": "HIV infection"
  },
  "aliases": [
    "VIH",
    "SIDA"
  ],
  "categories": [
    "infectious"
  ],
  "cellContext": {
    "cellType": "t-lymphocyte",
    "note": {
      "text": {
        "fr": "Le VIH infecte surtout les lymphocytes T CD4, des cellules du système immunitaire. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "HIV mainly infects CD4 T lymphocytes, cells of the immune system. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-hiv"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Infection par le VIH, un rétrovirus : son génome d'ARN est recopié en ADN puis intégré dans les chromosomes de la cellule, qui produit alors de nouveaux virus.",
      "en": "Infection with HIV, a retrovirus: its RNA genome is copied into DNA and then integrated into the cell's chromosomes, so the cell goes on to produce new viruses."
    },
    "sources": [
      {
        "id": "sp-hiv"
      },
      {
        "id": "mboc4-viral-integration"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Le virus de l'immunodéficience humaine, transmis notamment par voie sexuelle ou sanguine.",
        "en": "The human immunodeficiency virus, transmitted notably through sexual contact or blood."
      },
      "sources": [
        {
          "id": "sp-hiv"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "nucleus"
  ],
  "affectedPathways": [
    "entrée virale",
    "transcription inverse",
    "intégration"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Entrée",
        "en": "Entry"
      },
      "explanation": {
        "text": {
          "fr": "Le virus se fixe au récepteur CD4 et à un corécepteur, puis son enveloppe fusionne avec la membrane.",
          "en": "The virus binds to the CD4 receptor and a co-receptor, then its envelope fuses with the membrane."
        },
        "sources": [
          {
            "id": "sp-hiv"
          },
          {
            "id": "mboc4-virus-entry"
          }
        ]
      },
      "organelle": "plasma-membrane"
    },
    {
      "title": {
        "fr": "Intégration",
        "en": "Integration"
      },
      "explanation": {
        "text": {
          "fr": "La transcriptase inverse recopie l'ARN viral en ADN, que l'intégrase insère dans un chromosome de la cellule.",
          "en": "Reverse transcriptase copies the viral RNA into DNA, which integrase inserts into one of the cell's chromosomes."
        },
        "sources": [
          {
            "id": "sp-hiv"
          },
          {
            "id": "mboc4-viral-integration"
          }
        ]
      },
      "organelle": "nucleus"
    },
    {
      "title": {
        "fr": "Production et perte de lymphocytes",
        "en": "Virus production and lymphocyte loss"
      },
      "explanation": {
        "text": {
          "fr": "La cellule produit de nouveaux virus ; au fil du temps, le nombre de lymphocytes T CD4 diminue.",
          "en": "The cell produces new viruses; over time, the number of CD4 T lymphocytes falls."
        },
        "sources": [
          {
            "id": "sp-hiv"
          }
        ]
      }
    }
  ],
