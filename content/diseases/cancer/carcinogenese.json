  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "La plupart des cancers naissent de cellules épithéliales. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "mboc4-cancer"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Un cancer naît d'une cellule qui accumule des mutations : elle se divise sans contrôle, échappe à la mort cellulaire programmée et devient génétiquement instable."
    },
    "sources": [
      {
        "id": "mboc4-cancer"
      },
      {
        "id": "mboc4-cancer-behaviour"
      }
    ],
    "simplification": {
      "fr": "Les cellules voisines qui apparaissent et le noyau qui grossit sont des représentations schématiques."
    }
  },
  "cause": [
    {
      "text": {
        "fr": "Des mutations s'accumulent dans des gènes qui contrôlent la division (oncogènes et gènes suppresseurs de tumeur), par exemple le gène p53."
      },
      "sources": [
        {
          "id": "mboc4-cancer-behaviour"
        },
        {
          "id": "mboc4-cancer-division"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "nucleus",
    "cytoskeleton"
  ],
  "affectedPathways": [
    "contrôle du cycle cellulaire",
    "apoptose"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Division incontrôlée"
      },
      "explanation": {
        "text": {
          "fr": "Les gènes mutés stimulent la division ou ne la freinent plus."
        },
        "sources": [
          {
            "id": "mboc4-cancer-division"
          }
        ]
      },
      "organelle": "nucleus"
    },
    {
      "title": {
        "fr": "Échappement à l'apoptose"
      },
      "explanation": {
        "text": {
          "fr": "Des mutations de gènes qui régulent l'apoptose permettent aux cellules cancéreuses de ne pas mourir."
        },
        "sources": [
          {
            "id": "mboc4-cancer-apoptosis"
          }
        ]
      }
    },
    {
      "title": {
        "fr": "Instabilité génétique"
      },
      "explanation": {
        "text": {
          "fr": "Chaque cancer porte son propre ensemble de lésions génétiques, qui s'accumulent au fil des divisions."
        },
        "sources": [
          {
            "id": "mboc4-cancer-behaviour"
          }
        ]
      },
      "organelle": "nucleus"
    }
  ],
