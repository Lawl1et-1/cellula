{
  "id": "diabete-type-2",
  "slug": "diabete-de-type-2",
  "name": {
    "fr": "Diabète de type 2",
    "en": "Type 2 diabetes"
  },
  "aliases": [],
  "categories": [
    "metabolic"
  ],
  "cellContext": {
    "cellType": "generic",
    "note": {
      "text": {
        "fr": "Les muscles, le foie et le tissu adipeux deviennent résistants à l'insuline. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "Muscle, liver and fat tissue become resistant to insulin. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "sp-t2d"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie métabolique : les cellules répondent moins bien à l'insuline (insulinorésistance) et le pancréas n'en produit plus assez pour compenser, d'où une hyperglycémie.",
      "en": "A metabolic disease: cells respond less well to insulin (insulin resistance) and the pancreas can no longer make enough to compensate, leading to high blood sugar."
    },
    "sources": [
      {
        "id": "sp-t2d"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Une combinaison de prédisposition génétique et de facteurs de mode de vie, notamment le surpoids et la sédentarité.",
        "en": "A combination of genetic predisposition and lifestyle factors, notably excess weight and physical inactivity."
      },
      "sources": [
        {
          "id": "sp-t2d"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane"
  ],
  "affectedPathways": [
    "signalisation de l'insuline",
    "entrée du glucose"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Insulinorésistance",
        "en": "Insulin resistance"
      },
      "explanation": {
        "text": {
          "fr": "Les cellules répondent moins à l'insuline et captent moins de glucose.",
          "en": "Cells respond less to insulin and take up less glucose."
        },
        "sources": [
          {
            "id": "sp-t2d"
          }
        ]
      },
      "organelle": "plasma-membrane"
    },
    {
      "title": {
        "fr": "Épuisement des cellules bêta",
        "en": "Beta-cell exhaustion"
      },
      "explanation": {
        "text": {
          "fr": "Avec le temps, la sécrétion d'insuline par les cellules bêta du pancréas devient insuffisante.",
          "en": "Over time, insulin secretion by the beta cells of the pancreas becomes insufficient."
        },
        "sources": [
          {
            "id": "sp-t2d"
          }
        ]
      }
    }
  ],
