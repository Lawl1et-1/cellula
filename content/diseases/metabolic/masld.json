{
  "id": "masld",
  "slug": "steatose-hepatique-metabolique",
  "name": {
    "fr": "Stéatose hépatique métabolique (MASLD)"
  },
  "aliases": [
    "NAFLD",
    "Stéatose hépatique non alcoolique"
  ],
  "categories": [
    "metabolic"
  ],
  "cellContext": {
    "cellType": "hepatocyte",
    "note": {
      "text": {
        "fr": "Ce sont les hépatocytes, les cellules du foie, qui se chargent de graisse. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "sp-masld"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie du foie liée au métabolisme : des graisses s'accumulent dans les hépatocytes sous forme de gouttelettes lipidiques ; la maladie peut évoluer vers l'inflammation et la fibrose."
    },
    "sources": [
      {
        "id": "sp-masld"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Elle est associée au surpoids, au diabète de type 2 et à d'autres facteurs métaboliques."
      },
      "sources": [
        {
          "id": "sp-masld"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "cytoplasm"
  ],
  "affectedPathways": [
    "métabolisme des lipides"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Stéatose"
      },
      "explanation": {
        "text": {
          "fr": "Les triglycérides s'accumulent dans l'hépatocyte en gouttelettes lipidiques."
        },
        "sources": [
          {
