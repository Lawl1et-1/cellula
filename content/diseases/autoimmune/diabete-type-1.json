  "mechanism": [
    {
      "title": {
        "fr": "Attaque immunitaire",
        "en": "Immune attack"
      },
      "explanation": {
        "text": {
          "fr": "Des lymphocytes T s'attaquent aux cellules bêta.",
          "en": "T lymphocytes attack the beta cells."
        },
        "sources": [
          {
            "id": "sp-t1d"
          }
        ]
      }
    },
    {
      "title": {
        "fr": "Mort par apoptose",
        "en": "Death by apoptosis"
      },
      "explanation": {
        "text": {
          "fr": "La cellule meurt par apoptose : elle se rétracte, sa membrane bourgeonne et sa chromatine se condense puis se fragmente.",
          "en": "The cell dies by apoptosis: it shrinks, its membrane blebs, and its chromatin condenses and then breaks up."
        },
        "sources": [
          {
            "id": "mboc4-apoptosis"
          }
        ]
      },
      "organelle": "nucleus"
    },
    {
      "title": {
        "fr": "Carence en insuline",
        "en": "Insulin deficiency"
      },
      "explanation": {
        "text": {
          "fr": "Quand la plupart des cellules bêta sont détruites, l'insuline manque.",
          "en": "Once most beta cells are destroyed, insulin runs short."
        },
        "sources": [
          {
            "id": "sp-t1d"
          }
        ]
      }
    }
  ],
