      },
      "explanation": {
        "text": {
          "fr": "Quand la plupart des cellules bêta sont détruites, l'insuline manque.",
          "en": "Once most beta cells are destroyed, insulin runs short."
        },
        "sources": [
          {
            "id": "sp-t1d"
          }
        ]
      }
    }
