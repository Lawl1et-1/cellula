        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie auto-immune : le système immunitaire détruit les cellules bêta du pancréas, qui produisent l'insuline.",
      "en": "An autoimmune disease: the immune system destroys the beta cells of the pancreas, which make insulin."
    },
    "sources": [
      {
        "id": "sp-t1d"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Une réaction auto-immune, sur un terrain génétique favorable, dirigée contre les cellules bêta.",
        "en": "An autoimmune reaction against beta cells, on a predisposing genetic background."
      },
      "sources": [
        {
          "id": "sp-t1d"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
