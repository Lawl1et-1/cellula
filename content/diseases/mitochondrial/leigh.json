          "id": "gr-leigh-mtdna"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie mitochondriale : un défaut de la chaîne respiratoire réduit la production d'énergie (ATP) par les mitochondries.",
      "en": "A mitochondrial disease: a defect in the respiratory chain reduces the production of energy (ATP) by mitochondria."
    },
    "sources": [
      {
        "id": "gr-leigh-mtdna"
      },
      {
        "id": "mboc4-electron-transport"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants de l'ADN mitochondrial, par exemple dans le gène MT-ATP6 d'une sous-unité de l'ATP synthase, altèrent la phosphorylation oxydative.",
        "en": "Variants of mitochondrial DNA, for example in the MT-ATP6 gene for a subunit of ATP synthase, impair oxidative phosphorylation."
      },
      "sources": [
        {
          "id": "gr-leigh-mtdna"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "mitochondrion"
  ],
