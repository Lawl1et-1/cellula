              "id": "sp-xp"
            }
          ]
        }
      ],
      "focus": "dna"
    },
    {
      "id": "reparation",
      "title": {
        "fr": "La réparation échoue"
      },
      "range": [
        0.32,
        0.66
      ],
      "description": {
        "text": {
          "fr": "Normalement, la réparation par excision de nucléotides retire et remplace le segment abîmé. Dans le XP, elle est défaillante : les lésions restent en place."
        },
        "sources": [
          {
            "id": "gr-xp"
          }
        ]
      },
      "cellularSigns": [
        {
          "text": {
            "fr": "Les lésions persistent au lieu d'être réparées."
          },
          "sources": [
            {
              "id": "gr-xp"
            }
          ]
        }
      ],
      "focus": "dna"
    },
    {
      "id": "mutations",
