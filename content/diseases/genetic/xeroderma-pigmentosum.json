{
  "id": "xeroderma-pigmentosum",
  "slug": "xeroderma-pigmentosum",
  "name": {
    "fr": "Xeroderma pigmentosum"
  },
  "aliases": [
    "XP"
  ],
  "categories": [
    "genetic",
    "cancer"
  ],
  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Les cellules touchées sont surtout celles de la peau et des yeux exposées au soleil. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "gr-xp"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie génétique rare : les cellules réparent mal l'ADN abîmé par les ultraviolets. Les lésions s'accumulent dans la peau exposée au soleil, où des cancers apparaissent très tôt."
    },
    "sources": [
      {
        "id": "gr-xp"
      },
      {
        "id": "sp-xp"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants des deux copies (transmission autosomique récessive) d'un gène de la réparation de l'ADN par excision de nucléotides (XPA à XPG), ou du gène POLH dans la forme « variante »."
      },
      "sources": [
        {
          "id": "gr-xp"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "dna",
    "nucleus"
  ],
  "affectedPathways": [
    "réparation par excision de nucléotides"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Lésions dues aux UV"
      },
      "explanation": {
        "text": {
          "fr": "Les rayons ultraviolets lient entre elles des bases voisines de l'ADN (dimères de pyrimidines), ce qui déforme la double hélice."
        },
        "sources": [
          {
            "id": "sp-xp"
          },
          {
            "id": "gr-xp"
          }
        ]
      },
      "organelle": "dna"
    },
    {
      "title": {
        "fr": "Réparation défaillante"
      },
      "explanation": {
        "text": {
          "fr": "La réparation par excision de nucléotides découpe normalement le segment abîmé et le resynthétise ; dans le XP, une de ses protéines manque et les lésions persistent."
        },
        "sources": [
          {
            "id": "gr-xp"
          }
        ]
      },
      "organelle": "dna"
    },
    {
      "title": {
        "fr": "Mutations et cancers"
      },
      "explanation": {
        "text": {
          "fr": "Les lésions non réparées deviennent des mutations, qui conduisent à des cancers de la peau dès l'enfance."
        },
        "sources": [
          {
            "id": "gr-xp"
          },
          {
            "id": "sp-xp"
          }
        ]
      },
      "organelle": "dna"
    }
  ],
  "durationSeconds": 45,
  "stages": [
    {
      "id": "uv",
      "title": {
        "fr": "Les UV abîment l'ADN"
      },
      "range": [
        0,
        0.32
      ],
      "description": {
        "text": {
          "fr": "Les ultraviolets du soleil atteignent le noyau et lient entre elles des bases voisines de l'ADN : des dimères de pyrimidines apparaissent."
        },
        "sources": [
          {
            "id": "sp-xp"
          },
