  "cellContext": {
    "cellType": "epithelial",
    "note": {
      "text": {
        "fr": "Les cellules épithéliales des voies respiratoires, du pancréas et d'autres organes sont touchées. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "gr-cf"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie génétique due à des variants du gène CFTR, qui code un canal à chlorure de la membrane des cellules épithéliales. Avec le variant le plus fréquent, la protéine est mal repliée et retenue dans le réticulum endoplasmique."
    },
    "sources": [
      {
        "id": "gr-cf"
      },
      {
        "id": "mboc4-er"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants des deux copies du gène CFTR ; le plus fréquent est p.Phe508del."
      },
      "sources": [
        {
          "id": "gr-cf"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "rough-er",
    "plasma-membrane"
  ],
  "affectedPathways": [
    "contrôle qualité du RE",
    "transport du chlore"
  ],
