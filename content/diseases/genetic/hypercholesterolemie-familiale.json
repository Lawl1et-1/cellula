  "summary": {
    "text": {
      "fr": "Maladie génétique : les cellules captent mal le cholestérol LDL du sang, dont le taux augmente.",
      "en": "A genetic disease: cells take up LDL cholesterol from the blood poorly, so its level rises."
    },
    "sources": [
      {
        "id": "gr-fh"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants, le plus souvent du gène LDLR, réduisent la capture des LDL par les cellules.",
        "en": "Variants, most often of the LDLR gene, reduce LDL uptake by cells."
      },
      "sources": [
        {
          "id": "gr-fh"
        }
      ]
    }
  ],
