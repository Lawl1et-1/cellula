  "cellContext": {
    "cellType": "muscle-fiber",
    "note": {
      "text": {
        "fr": "Les fibres musculaires sont touchées. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées.",
        "en": "Muscle fibres are affected. The model shows a generic cell; the changes shown are those described in the affected cells."
      },
      "sources": [
        {
          "id": "gr-dystrophinopathies"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie génétique liée au chromosome X : l'absence de dystrophine, qui relie le cytosquelette des fibres musculaires à leur membrane, rend celle-ci fragile.",
      "en": "An X-linked genetic disease: the lack of dystrophin, which links the cytoskeleton of muscle fibres to their membrane, makes the membrane fragile."
    },
    "sources": [
      {
        "id": "gr-dystrophinopathies"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants du gène DMD, situé sur le chromosome X, empêchent la production de dystrophine.",
        "en": "Variants of the DMD gene, on the X chromosome, prevent dystrophin from being made."
      },
      "sources": [
        {
          "id": "gr-dystrophinopathies"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "cytoskeleton"
  ],
  "affectedPathways": [
    "ancrage membrane–cytosquelette"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Dystrophine absente",
        "en": "No dystrophin"
      },
      "explanation": {
        "text": {
          "fr": "Sans dystrophine, le lien entre le cytosquelette d'actine et la membrane est rompu.",
          "en": "Without dystrophin, the link between the actin cytoskeleton and the membrane is broken."
        },
        "sources": [
          {
            "id": "gr-dystrophinopathies"
          }
        ]
      },
      "organelle": "cytoskeleton"
    },
    {
      "title": {
        "fr": "Membrane fragile",
        "en": "Fragile membrane"
      },
      "explanation": {
        "text": {
          "fr": "La membrane des fibres musculaires est endommagée lors des contractions et les fibres dégénèrent.",
          "en": "The membrane of muscle fibres is damaged during contractions and the fibres degenerate."
        },
        "sources": [
          {
            "id": "gr-dystrophinopathies"
          }
        ]
      },
      "organelle": "plasma-membrane"
    }
  ],
