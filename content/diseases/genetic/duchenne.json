{
  "id": "duchenne",
  "slug": "myopathie-de-duchenne",
  "name": {
    "fr": "Myopathie de Duchenne"
  },
  "aliases": [
    "Dystrophie musculaire de Duchenne"
  ],
  "categories": [
    "genetic"
  ],
  "cellContext": {
    "cellType": "muscle-fiber",
    "note": {
      "text": {
        "fr": "Les fibres musculaires sont touchées. Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "gr-dystrophinopathies"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie génétique liée au chromosome X : l'absence de dystrophine, qui relie le cytosquelette des fibres musculaires à leur membrane, rend celle-ci fragile."
    },
    "sources": [
      {
        "id": "gr-dystrophinopathies"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants du gène DMD, situé sur le chromosome X, empêchent la production de dystrophine."
      },
      "sources": [
        {
          "id": "gr-dystrophinopathies"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "plasma-membrane",
    "cytoskeleton"
  ],
  "affectedPathways": [
    "ancrage membrane–cytosquelette"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Dystrophine absente"
      },
      "explanation": {
        "text": {
          "fr": "Sans dystrophine, le lien entre le cytosquelette d'actine et la membrane est rompu."
        },
        "sources": [
          {
            "id": "gr-dystrophinopathies"
          }
        ]
      },
      "organelle": "cytoskeleton"
    },
    {
      "title": {
        "fr": "Membrane fragile"
      },
      "explanation": {
        "text": {
          "fr": "La membrane des fibres musculaires est endommagée lors des contractions et les fibres dégénèrent."
        },
        "sources": [
          {
            "id": "gr-dystrophinopathies"
          }
        ]
      },
      "organelle": "plasma-membrane"
    }
  ],
