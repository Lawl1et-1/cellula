  "mechanism": [
    {
      "title": {
        "fr": "Huntingtine anormale",
        "en": "Abnormal huntingtin"
      },
      "explanation": {
        "text": {
          "fr": "La protéine produite contient une longue répétition de glutamines qui favorise son mauvais repliement.",
          "en": "The protein produced contains a long run of glutamines that promotes its misfolding."
        },
