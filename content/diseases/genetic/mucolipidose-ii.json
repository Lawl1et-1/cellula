{
  "id": "mucolipidose-ii",
  "slug": "mucolipidose-de-type-ii",
  "name": {
    "fr": "Mucolipidose de type II (maladie des cellules I)"
  },
  "aliases": [
    "Maladie des cellules I",
    "I-cell disease"
  ],
  "categories": [
    "genetic",
    "lysosomal-storage"
  ],
  "cellContext": {
    "cellType": "fibroblast",
    "note": {
      "text": {
        "fr": "Les fibroblastes des patients contiennent de nombreuses inclusions, d'où le nom de « cellules I » (inclusion cells). Le modèle montre une cellule générique ; les changements représentés sont ceux décrits dans les cellules touchées."
      },
      "sources": [
        {
          "id": "gr-gnptab"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Les enzymes lysosomales ne reçoivent pas leur étiquette d'adressage dans l'appareil de Golgi : elles sont sécrétées hors de la cellule au lieu d'être livrées aux lysosomes, qui se remplissent de matériel non dégradé."
    },
    "sources": [
      {
        "id": "gr-gnptab"
      },
      {
        "id": "mboc4-golgi-to-lysosomes"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants du gène GNPTAB rendent déficiente l'enzyme qui ajoute le mannose-6-phosphate aux enzymes lysosomales."
      },
      "sources": [
        {
          "id": "gr-gnptab"
        },
        {
          "id": "mboc4-golgi-to-lysosomes"
        }
      ]
    }
  ],
  "affectedOrganelles": [
    "golgi",
    "lysosome"
  ],
  "affectedPathways": [
    "adressage vers les lysosomes",
    "mannose-6-phosphate"
  ],
  "mechanism": [
    {
      "title": {
        "fr": "Étiquette manquante"
      },
      "explanation": {
        "text": {
          "fr": "Sans mannose-6-phosphate, les enzymes ne sont pas reconnues par le récepteur qui les dirige vers les lysosomes."
        },
        "sources": [
          {
            "id": "mboc4-golgi-to-lysosomes"
          }
        ]
      },
      "organelle": "golgi"
    },
    {
      "title": {
        "fr": "Enzymes perdues"
      },
      "explanation": {
        "text": {
          "fr": "Les enzymes partent alors par la voie de sécrétion et quittent la cellule."
        },
        "sources": [
          {
            "id": "mboc4-golgi-to-lysosomes"
          },
          {
            "id": "gr-gnptab"
          }
        ]
      },
      "organelle": "golgi"
    },
    {
      "title": {
        "fr": "Lysosomes vides d'enzymes"
      },
      "explanation": {
        "text": {
          "fr": "Privés de leurs enzymes, les lysosomes ne peuvent plus dégrader leur contenu, qui s'accumule."
        },
        "sources": [
          {
            "id": "gr-gnptab"
          }
        ]
      },
      "organelle": "lysosome"
    }
  ],
