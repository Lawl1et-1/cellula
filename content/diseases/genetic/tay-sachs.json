        {
          "id": "gr-hexa"
        }
      ]
    }
  },
  "summary": {
    "text": {
      "fr": "Maladie de surcharge lysosomale : faute d'une enzyme fonctionnelle, le ganglioside GM2 s'accumule dans les lysosomes, qui gonflent et perturbent la cellule."
    },
    "sources": [
      {
        "id": "gr-hexa"
      },
      {
        "id": "mboc4-lysosome-digestion"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants du gène HEXA entraînent un déficit en β-hexosaminidase A, l'enzyme lysosomale qui dégrade le ganglioside GM2."
      },
      "sources": [
        {
          "id": "gr-hexa"
        }
      ]
    }
  ],
