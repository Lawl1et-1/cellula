  "summary": {
    "text": {
      "fr": "Maladie génétique de la formation des peroxysomes : leurs enzymes ne sont pas importées, si bien que des fonctions comme la dégradation des acides gras à très longue chaîne sont perdues.",
      "en": "A genetic disease of peroxisome formation: their enzymes are not imported, so functions such as the breakdown of very-long-chain fatty acids are lost."
    },
    "sources": [
      {
        "id": "gr-zellweger"
      },
      {
        "id": "mboc4-peroxisomes"
      }
    ]
  },
  "cause": [
    {
      "text": {
        "fr": "Des variants de gènes PEX, nécessaires à la formation des peroxysomes.",
        "en": "Variants of PEX genes, which are needed to form peroxisomes."
      },
      "sources": [
        {
          "id": "gr-zellweger"
        }
      ]
    }
  ],
