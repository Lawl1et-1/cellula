{
  "id": "respiration",
  "slug": "respiration-cellulaire",
  "name": {
    "fr": "Respiration cellulaire"
  },
  "summary": {
    "text": {
      "fr": "Comment la cellule tire son énergie du glucose : la glycolyse dans le cytosol, puis l'oxydation dans les mitochondries, qui produit l'essentiel de l'ATP grâce à l'oxygène."
    },
    "sources": [
      {
        "id": "mboc4-energy-from-food"
      },
      {
        "id": "mboc4-electron-transport"
      }
    ],
    "simplification": {
      "fr": "Les quantités de molécules ne sont pas à l'échelle ; les flèches montrent le sens des échanges."
    }
  },
  "durationSeconds": 60,
  "stages": [
    {
      "id": "entree",
      "title": {
        "fr": "Entrée du glucose"
      },
      "range": [
        0,
        0.2
      ],
      "description": {
        "text": {
          "fr": "Le glucose traverse la membrane plasmique grâce à des protéines de transport."
        },
        "sources": [
          {
            "id": "mboc4-membrane-transport"
          }
        ]
      },
      "focus": "plasma-membrane"
    },
    {
      "id": "glycolyse",
      "title": {
        "fr": "Glycolyse"
      },
      "range": [
        0.2,
        0.4
      ],
      "description": {
        "text": {
          "fr": "Dans le cytosol, la glycolyse découpe chaque molécule de glucose en deux molécules de pyruvate et produit un peu d'ATP."
        },
        "sources": [
          {
            "id": "mboc4-energy-from-food"
          }
        ]
      },
      "focus": "cytoplasm"
    },
    {
      "id": "krebs",
      "title": {
        "fr": "Pyruvate et cycle de l'acide citrique"
      },
      "range": [
        0.4,
        0.55
      ],
      "description": {
        "text": {
          "fr": "Le pyruvate entre dans la mitochondrie, où il est transformé en acétyl-CoA qui alimente le cycle de l'acide citrique dans la matrice."
        },
        "sources": [
          {
            "id": "mboc4-energy-from-food"
          },
          {
            "id": "mboc4-mitochondrion"
          }
        ]
      },
      "focus": "mitochondrion"
    },
    {
      "id": "chaine",
      "title": {
        "fr": "Chaîne respiratoire"
      },
      "range": [
        0.55,
        0.8
      ],
      "description": {
        "text": {
          "fr": "Les électrons riches en énergie passent le long de la chaîne respiratoire de la membrane interne jusqu'à l'oxygène ; l'énergie libérée sert à pomper des protons hors de la matrice."
        },
        "sources": [
          {
            "id": "mboc4-electron-transport"
          }
        ]
      },
      "focus": "mitochondrion"
    },
    {
      "id": "atp",
      "title": {
        "fr": "Synthèse d'ATP"
      },
      "range": [
        0.8,
        1
      ],
      "description": {
        "text": {
          "fr": "Les protons reviennent dans la matrice à travers l'ATP synthase, qui fabrique l'ATP ; celui-ci est ensuite exporté vers le reste de la cellule."
        },
        "sources": [
          {
            "id": "mboc4-electron-transport"
          },
          {
            "id": "mboc4-mitochondrion"
          }
        ]
      },
      "focus": "mitochondrion"
    }
  ],
