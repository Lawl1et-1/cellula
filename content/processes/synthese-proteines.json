{
  "id": "synthese-proteines",
  "slug": "synthese-des-proteines",
  "name": {
    "fr": "Synthèse et sécrétion d'une protéine"
  },
  "summary": {
    "text": {
      "fr": "Le trajet d'une protéine sécrétée : de son gène dans le noyau jusqu'à sa libération hors de la cellule, en passant par le réticulum endoplasmique et l'appareil de Golgi."
    },
    "sources": [
      {
        "id": "mboc4-dna-to-rna"
      },
      {
        "id": "mboc4-er"
      },
      {
        "id": "mboc4-exocytosis"
      }
    ],
    "simplification": {
      "fr": "Les étapes sont enchaînées pour une seule protéine et fortement accélérées."
    }
  },
  "durationSeconds": 70,
  "stages": [
    {
      "id": "transcription",
      "title": {
        "fr": "Transcription"
      },
      "range": [
        0,
        0.18
      ],
      "description": {
        "text": {
          "fr": "Dans le noyau, l'ARN polymérase copie un gène en ARN messager."
        },
        "sources": [
          {
            "id": "mboc4-dna-to-rna"
          }
        ]
      },
      "focus": "nucleus"
    },
    {
      "id": "export",
      "title": {
        "fr": "Export de l'ARN messager"
      },
      "range": [
        0.18,
        0.32
      ],
      "description": {
        "text": {
          "fr": "L'ARN messager mature quitte le noyau à travers les complexes du pore nucléaire."
        },
        "sources": [
          {
            "id": "mboc4-nuclear-pores"
          },
          {
            "id": "mboc4-ran-transport"
          }
        ]
      },
      "focus": "nucleus"
    },
    {
      "id": "traduction",
      "title": {
        "fr": "Traduction au contact du RE"
      },
      "range": [
        0.32,
        0.5
      ],
      "description": {
        "text": {
          "fr": "Un ribosome commence la traduction ; une séquence signal de la protéine naissante le dirige vers le réticulum endoplasmique, et la chaîne protéique entre dans la lumière du RE au fur et à mesure de sa synthèse."
        },
        "sources": [
          {
            "id": "mboc4-rna-to-protein"
          },
          {
            "id": "mboc4-er"
          }
        ]
      },
      "focus": "rough-er"
    },
    {
      "id": "maturation",
      "title": {
        "fr": "Repliement et contrôle"
      },
      "range": [
        0.5,
        0.62
      ],
      "description": {
        "text": {
          "fr": "Dans le RE, la protéine est repliée avec l'aide de chaperons, souvent glycosylée, et contrôlée avant de poursuivre sa route."
        },
        "sources": [
          {
            "id": "mboc4-er"
          }
        ]
      },
      "focus": "rough-er"
    },
    {
      "id": "golgi",
      "title": {
        "fr": "Passage dans le Golgi"
      },
      "range": [
        0.62,
        0.82
      ],
      "description": {
        "text": {
          "fr": "Des vésicules l'apportent à la face cis du Golgi ; elle est modifiée en traversant les citernes puis triée dans le réseau trans-golgien."
        },
        "sources": [
          {
            "id": "mboc4-er-to-golgi"
          }
        ]
      },
      "focus": "golgi"
    },
    {
      "id": "secretion",
      "title": {
        "fr": "Sécrétion"
      },
      "range": [
        0.82,
        1
      ],
      "description": {
        "text": {
          "fr": "Des vésicules de sécrétion fusionnent avec la membrane plasmique et libèrent la protéine à l'extérieur : c'est l'exocytose."
        },
        "sources": [
          {
            "id": "mboc4-exocytosis"
          }
        ]
      },
      "focus": "plasma-membrane"
    }
  ],
