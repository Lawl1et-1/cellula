{
  "id": "lysosome",
  "name": {
    "fr": "Lysosome"
  },
  "tagline": {
    "fr": "Le centre de recyclage"
  },
  "summary": {
    "text": {
      "fr": "Compartiment acide rempli d'enzymes digestives (hydrolases) capables de dégrader les grandes molécules biologiques."
    },
    "sources": [
      {
        "id": "mboc4-lysosome-digestion"
      }
    ]
  },
  "function": [
    {
      "text": {
        "fr": "Il digère les macromolécules apportées par l'endocytose, la phagocytose ou l'autophagie."
      },
      "sources": [
        {
          "id": "mboc4-lysosome-digestion"
        },
        {
          "id": "mboc4-endocytosis"
        }
      ]
    },
    {
      "text": {
        "fr": "Les produits de la digestion sont renvoyés dans le cytosol pour être réutilisés."
      },
      "sources": [
        {
          "id": "mboc4-lysosome-digestion"
        }
      ]
    }
  ],
  "structure": [
    {
      "text": {
        "fr": "Sa membrane contient des pompes à protons qui maintiennent un pH acide à l'intérieur, nécessaire à l'activité de ses enzymes."
      },
      "sources": [
        {
          "id": "mboc4-lysosome-digestion"
        }
      ]
    }
  ],
  "keyMolecules": [
    {
      "name": {
        "fr": "Hydrolases acides"
      },
      "role": {
        "text": {
          "fr": "Enzymes (protéases, nucléases, lipases…) actives seulement en milieu acide."
        },
        "sources": [
          {
            "id": "mboc4-lysosome-digestion"
          }
        ]
      }
    },
    {
      "name": {
        "fr": "Pompe à protons (ATPase de type V)"
      },
      "role": {
        "text": {
          "fr": "Acidifie l'intérieur du lysosome."
        },
        "sources": [
          {
            "id": "mboc4-lysosome-digestion"
          }
        ]
      }
    }
  ],
  "interactions": [
    {
      "with": "golgi",
      "description": {
        "text": {
          "fr": "Ses enzymes lui sont livrées depuis le Golgi, triées grâce au mannose-6-phosphate."
        },
        "sources": [
          {
            "id": "mboc4-golgi-to-lysosomes"
          }
        ]
      }
    },
    {
      "with": "vesicle",
      "description": {
        "text": {
          "fr": "Les endosomes et autres vésicules lui apportent le matériel à dégrader."
        },
        "sources": [
          {
            "id": "mboc4-endocytosis"
          }
        ]
      }
    }
  ]
}
