{
  "id": "vesicle",
  "name": {
    "fr": "Vésicules"
  },
  "tagline": {
    "fr": "Les navettes de transport"
  },
  "summary": {
    "text": {
      "fr": "Petits sacs membranaires qui bourgeonnent d'un compartiment et fusionnent avec un autre, transportant protéines et lipides dans la cellule."
    },
    "sources": [
      {
        "id": "mboc4-er-to-golgi"
      },
      {
        "id": "mboc4-exocytosis"
      }
    ]
  },
  "function": [
    {
      "text": {
        "fr": "Elles relient le RE, le Golgi, les endosomes, les lysosomes et la membrane plasmique."
      },
      "sources": [
        {
          "id": "mboc4-er-to-golgi"
        },
        {
          "id": "mboc4-golgi-to-lysosomes"
        }
      ]
    },
    {
      "text": {
        "fr": "Des vésicules de sécrétion libèrent leur contenu hors de la cellule en fusionnant avec la membrane plasmique."
      },
      "sources": [
        {
          "id": "mboc4-exocytosis"
        }
      ]
    },
    {
      "text": {
        "fr": "Des vésicules d'endocytose apportent dans la cellule des molécules captées à sa surface."
      },
      "sources": [
        {
          "id": "mboc4-endocytosis"
        },
        {
          "id": "mboc4-receptor-endocytosis"
        }
      ]
    }
  ],
  "interactions": [
    {
      "with": "golgi",
      "description": {
        "text": {
          "fr": "Beaucoup naissent du réseau trans-golgien."
        },
        "sources": [
          {
            "id": "mboc4-exocytosis"
          }
        ]
      }
    },
    {
      "with": "cytoskeleton",
      "description": {
        "text": {
          "fr": "Elles circulent le long des microtubules, tirées par des moteurs."
        },
        "sources": [
          {
            "id": "mboc4-motors"
          }
        ]
      }
    }
  ]
}
